<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gacha Simulator</title>

<style>
body {
    font-family: Arial;
    background: linear-gradient(135deg, #1e1e2f, #3a3a6a);
    color: white;
    text-align: center;
    margin: 0;
}

.container {
    margin-top: 30px;
    padding: 10px;
}

.gacha-box {
    margin: auto;
    padding: 20px;
    width: 90%;
    max-width: 300px;
    background: rgba(255,255,255,0.1);
    border-radius: 15px;
}

button {
    margin-top: 15px;
    padding: 10px 20px;
    font-size: 18px;
    border: none;
    border-radius: 10px;
    background: gold;
    cursor: pointer;
}

button:hover {
    background: orange;
}

button:active {
    transform: scale(0.95);
}

/* CARD */
.card {
    width: 200px;
    height: 280px;
    margin: auto;
    perspective: 1000px;
}

.card-inner {
    width: 100%;
    height: 100%;
    position: relative;
    transition: transform 0.6s;
    transform-style: preserve-3d;
    will-change: transform;
}

@keyframes spin {
    0%   { transform: rotateY(0deg); }
    100% { transform: rotateY(1080deg); }
}

.card.spin .card-inner {
    animation: spin 0.8s ease-in-out;
}

.card.flip .card-inner {
    transform: rotateY(180deg);
}

.card-front, .card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: 12px;
    overflow: hidden;
}

.card-front {
    transform: rotateY(180deg);
}

.card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* EFFECT */
.glow-sr {
    box-shadow: 0 0 20px gold;
}

.glow-ar {
    box-shadow: 0 0 25px red;
    animation: pulse 1s infinite;
}

@keyframes pulse {
    0% { box-shadow: 0 0 10px red; }
    50% { box-shadow: 0 0 30px red; }
    100% { box-shadow: 0 0 10px red; }
}
</style>
</head>

<body>

<div class="container">
    <h1>TCG BLUE ARCHIVE GACHA</h1>

    <div class="gacha-box">

        <div class="card" id="card">
            <div class="card-inner">
                
                <div class="card-front">
                    <img id="result-img" src="img/back.png"
                    onerror="this.src='img/back.png'">
                </div>

                <div class="card-back">
                    <img src="img/back.png"
                    onerror="this.src='img/back.png'">
                </div>

            </div>
        </div>

        <h2 id="result-name">Tekan Gacha</h2>
        <p id="result-rarity"></p>

        <button onclick="gacha()">Gacha</button>

    </div>
</div>

<script>
// SCRIPT KAMU TIDAK DIUBAH SAMA SEKALI
const pool = [
    {name: "Neru", level: 0, rarityType: "N", img: "img/yneru0.png"},
    {name: "Neru", level: 1, rarityType: "N", img: "img/yneru1.png"},
    {name: "Neru", level: 2, rarityType: "N", img: "img/yneru2.png"},
    {name: "Neru", level: 3, rarityType: "N", img: "img/yneru3a.png"},
    {name: "Neru", level: 3, rarityType: "SR", img: "img/yneru3b.png"},

    {name: "Toki", level: 0, rarityType: "N", img: "img/rtoki0.png"},
    {name: "Toki", level: 1, rarityType: "N", img: "img/rtoki1.png"},
    {name: "Toki", level: 2, rarityType: "N", img: "img/rtoki2 .png"},
    {name: "Toki", level: 3, rarityType: "N", img: "img/rtoki3a.png"},
    {name: "Toki", level: 3, rarityType: "SR", img: "img/rtoki3b.png"},

    {name: "Mika", level: 0, rarityType: "N", img: "img/pmika0.png"},
    {name: "Mika", level: 1, rarityType: "N", img: "img/pmika1.png"},
    {name: "Mika", level: 2, rarityType: "N", img: "img/pmika2.png"},
    {name: "Mika", level: 3, rarityType: "N", img: "img/pmika3a.png"},

    {name: "Hoshino", level: 0, rarityType: "N", img: "img/bhoshino0.png"},
    {name: "Hoshino", level: 1, rarityType: "N", img: "img/bhoshino1.png"},
    {name: "Hoshino", level: 2, rarityType: "N", img: "img/bhoshino2.png"},
    {name: "Hoshino", level: 3, rarityType: "N", img: "img/bhoshino3a.png"},
    {name: "Hoshino", level: 3, rarityType: "SR", img: "img/bhoshino3b.png"},

    {name: "Noa", level: 0, rarityType: "N", img: "img/ynoa0.png"},
    {name: "Noa", level: 0, rarityType: "N", img: "img/ynoa0.png"},
    {name: "Noa", level: 0, rarityType: "N", img: "img/ynoa0.png"},

    {name: "Yuuka", level: 0, rarityType: "N", img: "img/ryuuka0.png"},
    {name: "Yuuka", level: 0, rarityType: "N", img: "img/ryuuka0.png"},
    {name: "Yuuka", level: 0, rarityType: "N", img: "img/ryuuka0.png"},

    {name: "Hanako", level: 0, rarityType: "N", img: "img/phanako0.png"},
    {name: "Hanako", level: 0, rarityType: "N", img: "img/phanako0.png"},
    {name: "Hanako", level: 0, rarityType: "N", img: "img/phanako0.png"},

    {name: "Eri", level: 0, rarityType: "N", img: "img/peri0.png"},
    {name: "Eri", level: 0, rarityType: "N", img: "img/peri0.png"},
    {name: "Eri", level: 0, rarityType: "N", img: "img/peri0.png"},

    {name: "Hoshino (HORUS)", level: 3, rarityType: "AR", img: "img/bhoshino3s.png"}
];
function gacha() {
    const rand = Math.random();
    let result;

    if (rand < 0.50) result = get(0);
    else if (rand < 0.75) result = get(1);
    else if (rand < 0.90) result = get(2);
    else if (rand < 0.97) result = get(3, "N");
    else if (rand < 0.995) result = get(3, "SR");
    else result = getType("AR");

    showResult(result);
}

function get(level, type = "N") {
    const list = pool.filter(c => c.level === level && c.rarityType === type);
    return list[Math.floor(Math.random() * list.length)];
}

function getType(type) {
    const list = pool.filter(c => c.rarityType === type);
    return list[Math.floor(Math.random() * list.length)];
}

function showResult(result) {
    const card = document.getElementById("card");
    const img = document.getElementById("result-img");
    const name = document.getElementById("result-name");
    const rarity = document.getElementById("result-rarity");

    card.classList.remove("flip", "spin", "glow-sr", "glow-ar");
    void card.offsetWidth;

    card.classList.add("spin");

    setTimeout(() => {

        img.src = result.img;

        let label = `Lv.${result.level}`;
        if (result.rarityType === "SR") label += " ★SR";
        if (result.rarityType === "AR") label += " ★AR";

        name.innerText = `${result.name} (${label})`;

        if (result.rarityType === "AR") {
            rarity.innerText = "✦✦✦";
            rarity.style.color = "red";
            card.classList.add("glow-ar");
        } 
        else if (result.rarityType === "SR") {
            rarity.innerText = "★★★★";
            rarity.style.color = "gold";
            card.classList.add("glow-sr");
        } 
        else {
            rarity.innerText = "★".repeat(result.level + 1);
            rarity.style.color = "white";
        }

        card.classList.remove("spin");

        setTimeout(() => {
            card.classList.add("flip");
        }, 100);

    }, 800);
}
</script>

</body>
</html>
